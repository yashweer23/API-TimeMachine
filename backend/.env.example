# Native development (start PostgreSQL and sample-api first).
DATABASE_URL=postgresql+psycopg://timemachine:local-development-only@127.0.0.1:5434/timemachine
ALLOWED_TARGET_ORIGINS=http://127.0.0.1:8001,http://127.0.0.1:8004
DEV_PRIVATE_ORIGINS=http://127.0.0.1:8001,http://127.0.0.1:8004
DEV_PRIVATE_CIDRS=127.0.0.1/32
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,http://localhost:8002,http://127.0.0.1:8002
TRUSTED_HOSTS=localhost,127.0.0.1
REDACT_FIELDS=

# UI sample defaults must also be present in ALLOWED_TARGET_ORIGINS.
SAMPLE_V1_BASE_URL=http://127.0.0.1:8001
SAMPLE_V2_BASE_URL=http://127.0.0.1:8004
# Shared direct/replay admission budget per backend process, rolling 60 seconds.
MAX_EXECUTIONS_PER_MINUTE=120
